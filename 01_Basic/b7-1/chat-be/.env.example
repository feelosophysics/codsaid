# 비밀 없는 설정 작성 예시입니다. 실제 서버는 .env 또는 서비스 환경변수를 읽고 이 예시 파일을 자동으로 쓰지
# 않습니다.
# 이름=값으로 작성합니다. 실제 API 키와 운영 JWT 키는 Git에 올리지 않습니다.
# Application Settings
APP_NAME="Construction Domain Knowledge Q&A Chatbot"
# development는 개발, production/prod는 운영입니다. 운영 모드에는 JWT 최소 조건 시작 검사가
# 적용됩니다.
APP_ENV="development"
# 개발 실행기의 자동 갱신 여부에 사용합니다. 운영 systemd/Uvicorn 실행 옵션과 같은 설정으로 단정하지
# 않습니다.
DEBUG=True
# 앱이 듣는 포트 번호입니다. 현재 운영은 8000 loopback 뒤에 Caddy HTTPS를 둡니다.
PORT=8000
# 개발 직접 실행 시 사용할 바인딩 주소입니다. 0.0.0.0은 모든 인터페이스이며 기존 운영 loopback 바인딩을
# 바꾸라는 뜻은 아닙니다.
HOST="0.0.0.0"
# 개발 프론트의 출처입니다. 운영은 ["https://b7-1-chat-fe.vercel.app"]로 설정합니다.
# JSON 배열이며 경로나 마지막 /를 넣지 않습니다. 미설정 기본값은 운영 프론트 한 곳입니다.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Authentication
# 실제 변수명은 SECRET_KEY와 ALGORITHM입니다 (JWT_SECRET_KEY/JWT_ALGORITHM은 읽지 않음).
# 운영에는 사용자가 직접 생성한 충분한 랜덤 키를 사용합니다. 원문을 로그/대화에 출력하지 않습니다.
# APP_ENV=production/prod에서는 아래 개발 기본값 또는 32바이트 미만의 키로 시작할 수 없습니다.
SECRET_KEY="feelosophysics-chatbot-super-secret-key-change-in-production"
ALGORITHM="HS256"
# 로그인 토큰의 유효기간을 분 단위로 정합니다. 1440분은 하루입니다.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (SQLite)
# DB 위치입니다. sqlite:/// 상대 경로는 실행 작업 폴더 기준이고 운영은 기존 절대 경로를 유지합니다.
DATABASE_URL="sqlite:///./chatbot.db"

# AI Model Settings (Google Gemini / Gemma 4 API)
# API 키를 발급받아 입력하세요 (https://aistudio.google.com/)
# 미설정 시 자동으로 Smart Demo/Mock 모드가 동작합니다.
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemma-4-26b-a4b-it"  # AI Studio Gemma 4 26B (또는 gemma-4-31b-it)
# Google 검색 도구를 기본으로 제공합니다. 실제 검색 여부는 모델이 판단합니다.
# 모델/프로젝트의 검색 지원·무료 할당량을 보장하는 설정은 아닙니다. False로 끌 수 있습니다.
GEMINI_SEARCH_ENABLED=True
# 연결 시작부터 스트림 완료까지의 전체 제한(초). 스트림 정리는 별도로 최대 1초.
AI_TIMEOUT_SECONDS=60
# 검색 도구를 제공하는 요청의 전체 제한입니다. 서버의 기존 .env 값은 예시 수정만으로 바뀌지 않습니다.
AI_SEARCH_TIMEOUT_SECONDS=90
# 최근 질문/답변 중 AI에게 함께 보낼 최대 메시지 개수입니다. DB 저장 기록을 이 개수로 지우지는 않습니다.
MAX_HISTORY_MESSAGES=10

# 단일 프로세스의 최근 60초 요청 제한. 양의 정수만 허용합니다.
REGISTER_REQUESTS_PER_MINUTE=5
LOGIN_REQUESTS_PER_MINUTE=10  # 로그인 + 비밀번호 변경을 IP별로 합산
CHAT_REQUESTS_PER_MINUTE=6
# 한 프로세스의 모든 사용자 채팅 횟수 합계 한도입니다. 개인 한도와 함께 검사합니다.
CHAT_GLOBAL_REQUESTS_PER_MINUTE=20
# 한 사용자가 동시에 진행할 수 있는 채팅 연결 수입니다. 응답 전송/취소가 끝나야 반환합니다.
CHAT_USER_CONCURRENCY=1
# 한 프로세스 전체의 동시 채팅 한도입니다. 다중 worker 사이의 공유 한도는 아닙니다.
CHAT_GLOBAL_CONCURRENCY=3
